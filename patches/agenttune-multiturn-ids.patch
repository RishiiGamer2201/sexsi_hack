+def _rerender_stream(tokenizer, conversation, schemas, enable_thinking, tool_result_format):
+    """sqlcf patch: (prompt_ids, completion_ids, mask) for a finished multi-turn trajectory,
+    taken from the chat-template rendering of the whole conversation, i.e. exactly the
+    context every next turn was generated from (turn headers, folded tool results), with
+    mask=1 only on assistant turns. Concatenating per-turn sampled ids + raw tool text
+    (the default) drops the template tokens between turns, so the trainer scored tokens
+    against a context vLLM never saw. None if the template is not prefix-consistent."""
+
+    def ids(conv, gen):
+        out = _render_chat_template(
+            tokenizer, conv, schemas, enable_thinking=enable_thinking,
+            tool_result_format=tool_result_format, tokenize=True, return_tensors=None,
+            add_generation_prompt=gen,
+        )
+        return _ids_to_list(out["input_ids"] if hasattr(out, "keys") else out)
+
+    turns = [i for i, m in enumerate(conversation) if m.get("role") == "assistant"]
+    if not turns:
+        return None
+    p0, full = ids(conversation[: turns[0]], True), ids(conversation, False)
+    mask = [0] * len(full)
+    for i in turns:
+        a, b = len(ids(conversation[:i], True)), len(ids(conversation[: i + 1], False))
+        mask[a:b] = [1] * (b - a)
+    if full[: len(p0)] != p0 or not any(mask[len(p0):]):
+        return None
+    return p0, full[len(p0):], mask[len(p0):]
+
+
