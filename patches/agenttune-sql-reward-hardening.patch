+# A WHERE clause only counts as a filter if it mentions a column. "where 1 = 1" or "where 'a' = 'a'" filters
+# nothing and must not earn the WHERE bonus.
+_WHERE_BODY_RE = re.compile(r"\bwhere\b(.*?)(?=\bgroup\s+by\b|\border\s+by\b|\bhaving\b|\blimit\b|\bunion\b|$)", re.DOTALL)
+_SQL_WORDS = {"and", "or", "not", "is", "null", "in", "like", "glob", "between", "true", "false", "exists", "select",
+              "case", "when", "then", "else", "end", "cast", "as", "integer", "text", "real", "escape"}
+
+
+def _has_real_where(sql: str) -> bool:
+    """True if the query has a WHERE clause that references at least one identifier (column)."""
+    m = _WHERE_BODY_RE.search(sql.lower())
+    if not m:
+        return False
+    body = re.sub(r"'(?:[^']|'')*'", " ", m.group(1))
+    return any(w not in _SQL_WORDS for w in re.findall(r"[a-z_][a-z0-9_.]*", body))
 
 
