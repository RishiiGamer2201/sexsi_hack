+def result_match_reward(completions, gold_rows=None, **kwargs):
+    """Compare the rows of the last successful tool result with the gold query's rows (order-blind multiset).
+
+    Pass ``gold_rows`` (one list of rows per completion) from the dataset. Unlike ``query_reward``'s
+    has_hits check, a query that returns *some* rows only scores when it returns the *right* rows."""
+    rewards = []
+    for i, completion in enumerate(completions):
+        gold = (gold_rows or [None] * len(completions))[i]
+        last = None
+        for turn in completion if isinstance(completion, list) else []:
+            if turn.get("role") == "tool" and isinstance(turn.get("content"), list):
+                last = turn["content"]
+        if gold is None:
+            score, reason = 0.0, "no gold_rows given -> 0.0"
+        elif last is None:
+            score, reason = -1.0, "no tool result rows -> -1.0"
+        else:
+            same = sorted(map(repr, map(tuple, last))) == sorted(map(repr, map(tuple, gold)))
+            score = 2.0 if same else -1.0
+            reason = f"last result rows {'match' if same else 'differ from'} gold rows -> {score}"
+        log_score("sql.result_match_reward", score, reasons=[reason], meta={"index": i})
+        rewards.append(score)
+    return rewards
+
